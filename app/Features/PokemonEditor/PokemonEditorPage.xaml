<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PKHeX.Android.Features.PokemonEditor.PokemonEditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:PKHeX.Android.ViewModels"
    x:DataType="vm:PokemonEditorViewModel"
    Title="{Binding Title}"
    BackgroundColor="{StaticResource BgBase}">

    <ScrollView>
        <VerticalStackLayout Spacing="10" Padding="14">

            <!-- ── Header card ─────────────────────────────────────────────── -->
            <Border BackgroundColor="{StaticResource BgCard}" Stroke="{StaticResource BorderSubtle}"
                StrokeThickness="1" Padding="14">
                <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto" RowSpacing="8" ColumnSpacing="12">

                    <!-- Sprite -->
                    <Border Grid.RowSpan="3" Grid.Column="0"
                        BackgroundColor="{StaticResource BgElevated}"
                        Stroke="{StaticResource BorderSubtle}" StrokeThickness="1"
                        WidthRequest="80" HeightRequest="80" VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Image Source="{Binding SpriteUrl}"
                            HeightRequest="72" WidthRequest="72"
                            Aspect="AspectFit"
                            IsVisible="{Binding IsNewPokemon, Converter={StaticResource InvertedBoolConverter}}"/>
                    </Border>

                    <!-- Species name + level -->
                    <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*, Auto">
                        <Label Text="{Binding SpeciesName}"
                            TextColor="{StaticResource TextPrimary}" FontSize="22" FontAttributes="Bold"
                            VerticalOptions="Center"/>
                        <Border Grid.Column="1"
                            BackgroundColor="{StaticResource BgElevated}" Padding="10,4" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Label Text="{Binding Level, StringFormat='Lv. {0}'}"
                                TextColor="{StaticResource AccentYellow}" FontSize="13" FontAttributes="Bold"/>
                        </Border>
                    </Grid>

                    <!-- Types + shiny -->
                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*, Auto">
                        <HorizontalStackLayout Spacing="6">
                            <Border BackgroundColor="{StaticResource AccentBlue}" Padding="10,3">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                <Label Text="{Binding Type1}" TextColor="White" FontSize="11" FontAttributes="Bold"/>
                            </Border>
                            <Border BackgroundColor="{StaticResource BgElevated}" Padding="10,3" IsVisible="{Binding HasType2}">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                <Label Text="{Binding Type2}" TextColor="{StaticResource TextSecondary}" FontSize="11"/>
                            </Border>
                        </HorizontalStackLayout>
                        <Label Grid.Column="1" Text="✦ Shiny"
                            TextColor="{StaticResource AccentYellow}" FontSize="12"
                            IsVisible="{Binding IsShiny}" VerticalOptions="Center"/>
                    </Grid>

                    <!-- Ball / OT -->
                    <Label Grid.Row="2" Grid.Column="1"
                        TextColor="{StaticResource TextMuted}" FontSize="11">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding BallName}"/>
                                <Span Text="  ·  " TextColor="{StaticResource TextMuted}"/>
                                <Span Text="{Binding OriginalTrainer}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Grid>
            </Border>

            <!-- ── Details / Editable fields ─────────────────────────────── -->
            <Border BackgroundColor="{StaticResource BgCard}" Stroke="{StaticResource BorderSubtle}"
                StrokeThickness="1" Padding="14">
                <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="DETAILS" TextColor="{StaticResource TextMuted}" FontSize="11" FontAttributes="Bold" Margin="0,0,0,2"/>

                    <!-- Species -->
                    <Grid ColumnDefinitions="72,*" ColumnSpacing="10">
                        <Label Text="Species" TextColor="{StaticResource TextMuted}" FontSize="13" VerticalOptions="Center"/>
                        <Border Grid.Column="1" BackgroundColor="{StaticResource BgElevated}"
                            Stroke="{StaticResource BorderSubtle}" Padding="4,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Picker ItemsSource="{Binding SpeciesList}" SelectedItem="{Binding SelectedSpecies}"
                                ItemDisplayBinding="{Binding DisplayName}"
                                TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent"
                                TitleColor="{StaticResource TextMuted}" FontSize="13"/>
                        </Border>
                    </Grid>

                    <!-- Nickname -->
                    <Grid ColumnDefinitions="72,*" ColumnSpacing="10"
                        IsVisible="{Binding IsNewPokemon, Converter={StaticResource InvertedBoolConverter}}">
                        <Label Text="Nickname" TextColor="{StaticResource TextMuted}" FontSize="13" VerticalOptions="Center"/>
                        <Border Grid.Column="1" BackgroundColor="{StaticResource BgElevated}"
                            Stroke="{StaticResource BorderSubtle}" Padding="12,8">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Entry Text="{Binding Nickname}" TextColor="{StaticResource TextPrimary}"
                                BackgroundColor="Transparent" FontSize="13"
                                Placeholder="Nickname" PlaceholderColor="{StaticResource TextMuted}"/>
                        </Border>
                    </Grid>

                    <!-- Level -->
                    <Grid ColumnDefinitions="72,*" ColumnSpacing="10"
                        IsVisible="{Binding IsNewPokemon, Converter={StaticResource InvertedBoolConverter}}">
                        <Label Text="Level" TextColor="{StaticResource TextMuted}" FontSize="13" VerticalOptions="Center"/>
                        <Border Grid.Column="1" BackgroundColor="{StaticResource BgElevated}"
                            Stroke="{StaticResource BorderSubtle}" Padding="12,8">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Entry Text="{Binding Level}" TextColor="{StaticResource TextPrimary}"
                                BackgroundColor="Transparent" FontSize="13" Keyboard="Numeric"/>
                        </Border>
                    </Grid>

                    <!-- Nature -->
                    <Grid ColumnDefinitions="72,*" ColumnSpacing="10"
                        IsVisible="{Binding IsNewPokemon, Converter={StaticResource InvertedBoolConverter}}">
                        <Label Text="Nature" TextColor="{StaticResource TextMuted}" FontSize="13" VerticalOptions="Center"/>
                        <Border Grid.Column="1" BackgroundColor="{StaticResource BgElevated}"
                            Stroke="{StaticResource BorderSubtle}" Padding="4,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Picker ItemsSource="{Binding Natures}" SelectedItem="{Binding SelectedNature}"
                                ItemDisplayBinding="{Binding Name}"
                                TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent"
                                TitleColor="{StaticResource TextMuted}" FontSize="13"/>
                        </Border>
                    </Grid>

                    <!-- Ability -->
                    <Grid ColumnDefinitions="72,*" ColumnSpacing="10"
                        IsVisible="{Binding IsNewPokemon, Converter={StaticResource InvertedBoolConverter}}">
                        <Label Text="Ability" TextColor="{StaticResource TextMuted}" FontSize="13" VerticalOptions="Center"/>
                        <Border Grid.Column="1" BackgroundColor="{StaticResource BgElevated}"
                            Stroke="{StaticResource BorderSubtle}" Padding="4,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Picker ItemsSource="{Binding Abilities}" SelectedItem="{Binding SelectedAbility}"
                                ItemDisplayBinding="{Binding DisplayName}"
                                TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent"
                                TitleColor="{StaticResource TextMuted}" FontSize="13"/>
                        </Border>
                    </Grid>

                    <!-- Friendship -->
                    <Grid ColumnDefinitions="72,*" ColumnSpacing="10"
                        IsVisible="{Binding IsNewPokemon, Converter={StaticResource InvertedBoolConverter}}">
                        <Label Text="Friendship" TextColor="{StaticResource TextMuted}" FontSize="13" VerticalOptions="Center"/>
                        <Border Grid.Column="1" BackgroundColor="{StaticResource BgElevated}"
                            Stroke="{StaticResource BorderSubtle}" Padding="12,8">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Entry Text="{Binding Friendship}" TextColor="{StaticResource TextPrimary}"
                                BackgroundColor="Transparent" FontSize="13" Keyboard="Numeric"/>
                        </Border>
                    </Grid>

                    <!-- Held item (read-only) -->
                    <Grid ColumnDefinitions="72,*" ColumnSpacing="10"
                        IsVisible="{Binding IsNewPokemon, Converter={StaticResource InvertedBoolConverter}}">
                        <Label Text="Item" TextColor="{StaticResource TextMuted}" FontSize="13" VerticalOptions="Center"/>
                        <Border Grid.Column="1" BackgroundColor="{StaticResource BgElevated}"
                            Stroke="{StaticResource BorderSubtle}" Padding="12,10">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Label Text="{Binding HeldItem}" TextColor="{StaticResource TextPrimary}" FontSize="13"/>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ── Stats ─────────────────────────────────────────────────── -->
            <Border BackgroundColor="{StaticResource BgCard}" Stroke="{StaticResource BorderSubtle}"
                StrokeThickness="1" Padding="14"
                IsVisible="{Binding IsNewPokemon, Converter={StaticResource InvertedBoolConverter}}">
                <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="38, *, 38, 44, 48" ColumnSpacing="8" Margin="0,0,0,6">
                        <Label Grid.Column="0" Text="STAT" TextColor="{StaticResource TextMuted}" FontSize="10" FontAttributes="Bold"/>
                        <Label Grid.Column="2" Text="VAL"  TextColor="{StaticResource TextMuted}" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Grid.Column="3" Text="IV"   TextColor="{StaticResource TextMuted}" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Grid.Column="4" Text="EV"   TextColor="{StaticResource TextMuted}" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Stats}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:StatRowViewModel">
                                <Grid ColumnDefinitions="38, *, 38, 44, 48" ColumnSpacing="8">
                                    <Label Text="{Binding Name}" TextColor="{StaticResource TextMuted}"
                                        FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
                                    <ProgressBar Grid.Column="1" Progress="{Binding FillRatio}"
                                        ProgressColor="{StaticResource AccentBlue}"
                                        BackgroundColor="{StaticResource BgElevated}"
                                        HeightRequest="5" VerticalOptions="Center"/>
                                    <Label Grid.Column="2" Text="{Binding Value}"
                                        TextColor="{StaticResource TextPrimary}"
                                        FontSize="12" FontAttributes="Bold"
                                        HorizontalOptions="Center" VerticalOptions="Center"/>
                                    <Border Grid.Column="3" BackgroundColor="{StaticResource BgElevated}"
                                        Stroke="{StaticResource BorderSubtle}" Padding="4,4">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                        <Entry Text="{Binding IV}" TextColor="{StaticResource TextPrimary}"
                                            BackgroundColor="Transparent" FontSize="11"
                                            Keyboard="Numeric" HorizontalTextAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Column="4" BackgroundColor="{StaticResource BgElevated}"
                                        Stroke="{StaticResource BorderSubtle}" Padding="4,4">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                        <Entry Text="{Binding EV}" TextColor="{StaticResource TextPrimary}"
                                            BackgroundColor="Transparent" FontSize="11"
                                            Keyboard="Numeric" HorizontalTextAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ── Moves ─────────────────────────────────────────────────── -->
            <Border BackgroundColor="{StaticResource BgCard}" Stroke="{StaticResource BorderSubtle}"
                StrokeThickness="1" Padding="14"
                IsVisible="{Binding IsNewPokemon, Converter={StaticResource InvertedBoolConverter}}">
                <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="MOVES" TextColor="{StaticResource TextMuted}" FontSize="11" FontAttributes="Bold" Margin="0,0,0,2"/>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Moves}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:MoveViewModel">
                                <Border BackgroundColor="{StaticResource BgElevated}"
                                    Stroke="{StaticResource BorderSubtle}" Padding="14,11">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PokemonEditorViewModel}}, Path=OpenMovePickerCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*, Auto, Auto">
                                        <Label Text="{Binding Name}" TextColor="{StaticResource TextPrimary}"
                                            FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                                        <Label Grid.Column="1"
                                            Text="{Binding PP, StringFormat='PP {0}'}"
                                            TextColor="{StaticResource TextMuted}" FontSize="12"
                                            VerticalOptions="Center" Margin="0,0,8,0"
                                            IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}"/>
                                        <Label Grid.Column="2" Text="›"
                                            TextColor="{StaticResource TextMuted}" FontSize="16"
                                            VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ── Legality ────────────────────────────────────────────────── -->
            <Border BackgroundColor="{StaticResource BgCard}" Stroke="{StaticResource BorderSubtle}"
                StrokeThickness="1" Padding="14"
                IsVisible="{Binding IsNewPokemon, Converter={StaticResource InvertedBoolConverter}}">
                <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="LEGALITY" TextColor="{StaticResource TextMuted}" FontSize="11" FontAttributes="Bold"/>
                        <Label Grid.Column="1" Text="✓ Legal" TextColor="{StaticResource AccentGreen}"
                            FontSize="12" FontAttributes="Bold" IsVisible="{Binding IsLegal}"/>
                        <Label Grid.Column="1" Text="✗ Illegal" TextColor="{StaticResource AccentRed}"
                            FontSize="12" FontAttributes="Bold"
                            IsVisible="{Binding IsLegal, Converter={StaticResource InvertedBoolConverter}}"/>
                    </Grid>
                    <Label Text="{Binding LegalityResult}" TextColor="{StaticResource TextMuted}"
                        FontSize="10" IsVisible="{Binding IsLegal, Converter={StaticResource InvertedBoolConverter}}"/>
                </VerticalStackLayout>
            </Border>

            <!-- ── Apply button ────────────────────────────────────────────── -->
            <Button
                Text="Apply Changes"
                Command="{Binding SaveChangesCommand}"
                BackgroundColor="{StaticResource AccentYellow}"
                TextColor="#0D0D14"
                FontAttributes="Bold"
                FontSize="16"
                HeightRequest="52"
                CornerRadius="14"
                Margin="0,4,0,28"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
