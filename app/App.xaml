<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="PKHeX.Android.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:conv="clr-namespace:PKHeX.Android.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml"/>
                <ResourceDictionary Source="Resources/Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
            <conv:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter"/>
            <conv:BoolToAccentConverter x:Key="BoolToAccentConverter"/>
            <conv:BoolToTextConverter x:Key="BoolToTextConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
