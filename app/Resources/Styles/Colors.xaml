<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Background layers -->
    <Color x:Key="BgBase">#0D0D14</Color>
    <Color x:Key="BgSurface">#14141F</Color>
    <Color x:Key="BgCard">#1C1C2A</Color>
    <Color x:Key="BgElevated">#252535</Color>

    <!-- Accent -->
    <Color x:Key="AccentYellow">#FFD600</Color>
    <Color x:Key="AccentBlue">#5B8CFF</Color>
    <Color x:Key="AccentRed">#FF4B4B</Color>
    <Color x:Key="AccentGreen">#4BDB6B</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#F0F0FF</Color>
    <Color x:Key="TextSecondary">#8888AA</Color>
    <Color x:Key="TextMuted">#444466</Color>

    <!-- Borders -->
    <Color x:Key="BorderSubtle">#2A2A3E</Color>
    <Color x:Key="BorderFocus">#5B8CFF</Color>

    <!-- Pokémon type colors -->
    <Color x:Key="TypeNormal">#A8A878</Color>
    <Color x:Key="TypeFire">#F08030</Color>
    <Color x:Key="TypeWater">#6890F0</Color>
    <Color x:Key="TypeGrass">#78C850</Color>
    <Color x:Key="TypeElectric">#F8D030</Color>
    <Color x:Key="TypeIce">#98D8D8</Color>
    <Color x:Key="TypeFighting">#C03028</Color>
    <Color x:Key="TypePoison">#A040A0</Color>
    <Color x:Key="TypeGround">#E0C068</Color>
    <Color x:Key="TypeFlying">#A890F0</Color>
    <Color x:Key="TypePsychic">#F85888</Color>
    <Color x:Key="TypeBug">#A8B820</Color>
    <Color x:Key="TypeRock">#B8A038</Color>
    <Color x:Key="TypeGhost">#705898</Color>
    <Color x:Key="TypeDragon">#7038F8</Color>
    <Color x:Key="TypeDark">#705848</Color>
    <Color x:Key="TypeSteel">#B8B8D0</Color>
    <Color x:Key="TypeFairy">#EE99AC</Color>
    <Color x:Key="TypeStellar">#4BC8C8</Color>

    <!-- Legacy aliases for MAUI default styles -->
    <Color x:Key="Primary">#5B8CFF</Color>
    <Color x:Key="PrimaryDark">#5B8CFF</Color>
    <Color x:Key="PrimaryDarkText">#F0F0FF</Color>
    <Color x:Key="Secondary">#FFD600</Color>
    <Color x:Key="SecondaryDarkText">#8888AA</Color>
    <Color x:Key="Tertiary">#252535</Color>
    <Color x:Key="White">#F0F0FF</Color>
    <Color x:Key="Black">#0D0D14</Color>
    <Color x:Key="Magenta">#FF4B4B</Color>
    <Color x:Key="MidnightBlue">#1C1C2A</Color>
    <Color x:Key="OffBlack">#0D0D14</Color>
    <Color x:Key="Gray100">#2A2A3E</Color>
    <Color x:Key="Gray200">#3A3A52</Color>
    <Color x:Key="Gray300">#4A4A66</Color>
    <Color x:Key="Gray400">#5A5A78</Color>
    <Color x:Key="Gray500">#6A6A8A</Color>
    <Color x:Key="Gray600">#8888AA</Color>
    <Color x:Key="Gray900">#C0C0D8</Color>
    <Color x:Key="Gray950">#F0F0FF</Color>

    <SolidColorBrush x:Key="AccentYellowBrush" Color="{StaticResource AccentYellow}"/>
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCard}"/>
    <SolidColorBrush x:Key="BgBaseBrush" Color="{StaticResource BgBase}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
